{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 12000
    },
    "buffer": 16000
  },
  "plugins": [
    "@dietrichgebert/ponytail"
  ],
  "permission": {
    "playwright_browser_run_code_unsafe": "ask"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["node", "/home/fikri/.config/opencode/node_modules/@playwright/mcp/cli.js", "--headless", "--isolated", "--output-dir", "/tmp/opencode/playwright-mcp"],
      "enabled": false
    },
    "github": {
      "type": "local",
      "command": [
        "/home/fikri/.local/bin/github-mcp-server",
        "stdio"
      ],
      "enabled": false
    }
  }
}
